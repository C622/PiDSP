#!/bin/bash
# Root helper for the PiDSP web interface. The web service may run only this
# script through sudo (see pidsp-web.sudoers). Each action is fixed; nothing
# from the caller reaches a shell except the new password, read from stdin.
#
#   pidsp-admin passwd     new password for the login user on stdin (8-128 chars)
#   pidsp-admin reboot
#   pidsp-admin poweroff
set -euo pipefail

LOGIN_USER=$(cat /etc/pidsp/login-user 2>/dev/null || echo pidsp)

case "${1:-}" in
  passwd)
    IFS= read -r pw || true
    if (( ${#pw} < 8 || ${#pw} > 128 )); then
      echo "The password must be 8 to 128 characters." >&2; exit 2
    fi
    printf '%s:%s\n' "$LOGIN_USER" "$pw" | chpasswd
    ;;
  reboot)   systemctl --no-block reboot ;;
  poweroff) systemctl --no-block poweroff ;;
  *) echo "usage: pidsp-admin passwd|reboot|poweroff" >&2; exit 2 ;;
esac
